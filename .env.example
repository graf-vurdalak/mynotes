# Общие
DEBUG=True
SITE_DOMAIN=<ваш_домен>
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
MYNOTES_WEB_IMAGE=ghcr.io/example/mynotes-web
MYNOTES_BOT_IMAGE=ghcr.io/example/mynotes-bot
IMAGE_TAG=latest

# База данных
POSTGRES_DB=mynotes
POSTGRES_USER=mynotes
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# S3 (self-hosted: SeaweedFS S3-гейтвей в docker / переносимо на Yandex Object Storage,
# AWS S3). Непустой S3_ENDPOINT включает S3-backend для файлов (config/settings/base.py).
# МинIO как образ недоступен с конца 2025 (реестры закрыты, репозиторий архивирован) —
# согласованная замена Этапа MinIO: SeaweedFS, экосистема та же (S3 API).
# Согласованный набор имён (в ТЗ опечатка S3ACCESSKEY/S3SECRETKEY без подчёркиваний).
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=mynotes
S3_REGION=us-east-1

# Email
# В dev: пустой EMAIL_HOST = фолбэк на локальный MailHog (mailhog:1025, без шифрования).
# Реальный SMTP: укажите EMAIL_HOST/PORT/USER/PASSWORD и один из флагов шифрования.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=False   # 465 = SMTPS; иначе используйте EMAIL_USE_TLS=True (STARTTLS)
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# Яндекс OAuth
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_SECRET=

# Telegram-боты
TELEGRAM_VEHICLE_BOT_TOKEN=
TELEGRAM_PLANNER_BOT_TOKEN=

# Sentry
SENTRY_DSN=

# Rate limiting
RATELIMIT_LOGIN=100/m
RATELIMIT_SIGNUP=5/m
RATELIMIT_API=300/m

# Безопасность токенов ботов (соль-пепр HMAC-SHA256; пусто → SECRET_KEY)
BOT_TOKEN_PEPPER=

# Fernet-ключ для шифрования чувствительных полей (VIN, ТЗ 8.5).
# Генерация: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Пусто → производный от SECRET_KEY (только dev). Задать до первой миграции с данными!
FERNET_KEY=
