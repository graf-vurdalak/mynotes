# ПРОМЫШЛЕННЫЙ .env — шаблон (Этап 9.1, ТЗ 13.2).
#
# Это ШАБЛОН без секретов: копируется на сервер как `.env` и заполняется.
#   cp .env.prod.template .env && chmod 600 .env
#
# Поля `<GEN:...>` — автоматически заполняются генератором секретов:
#   python scripts/gen_prod_secrets.py            (в контейнере web, прод-настройки)
# Поля `<...>` — заполняются вручную пользователем (креды внешних сервисов).
#
# Конкретный домен в коде/шаблоне запрещён ТЗ 1.4 — везде плейсхолдер
# `<ВАШ_ДОМЕН>`; реальное значение (mynotes.sokol-off.ru) вносится при
# развёртывании на сервере (инструкции 9.3/9.4), не в этот файл.

# ─── Общие ─────────────────────────────────────────────
DEBUG=False
SITE_DOMAIN=<ВАШ_ДОМЕН>
ALLOWED_HOSTS=<ВАШ_ДОМЕН>
SECRET_KEY=<GEN:django-secret-key>
# CSRF origin за HTTPS (Django 4+). Пусто → prod.py берёт https://<SITE_DOMAIN>.
# Несколько алиасов: через запятую, каждый с https://.
CSRF_TRUSTED_ORIGINS=

# ─── Образы GHCR (приватные; docker login ghcr.io на сервере — решение 9.2/9.3) ─
MYNOTES_WEB_IMAGE=ghcr.io/<OWNER>/mynotes-web
MYNOTES_BOT_IMAGE=ghcr.io/<OWNER>/mynotes-bot
IMAGE_TAG=latest

# ─── База данных ────────────────────────────────────────
POSTGRES_DB=mynotes
POSTGRES_USER=mynotes
POSTGRES_PASSWORD=<GEN:postgres-password>
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── S3 (SeaweedFS S3-гейтвей в docker-сети; переносимо на внешний S3) ──
# Непустой S3_ENDPOINT включает S3-backend файлов (base.py). В прод-стеке
# endpoint задаётся в compose (http://s3:8333), app-ключи — отсюда (те же,
# что в s3-prod.json, identity `app`). Pустой S3_ENDPOINT = откат на FileSystemStorage.
S3_ENDPOINT=
S3_ACCESS_KEY=<GEN:s3-app-access>
S3_SECRET_KEY=<GEN:s3-app-secret>
S3_BUCKET=mynotes
S3_REGION=us-east-1

# ─── Email (SMTP; порты 465=SMTPS / 587=STARTTLS) ───────
# 465: EMAIL_USE_SSL=True,  EMAIL_USE_TLS=False
# 587: EMAIL_USE_SSL=False, EMAIL_USE_TLS=True
EMAIL_HOST=<SMTP_ХОСТ>
EMAIL_PORT=465
EMAIL_HOST_USER=<SMTP_ПОЛЬЗОВАТЕЛЬ>
EMAIL_HOST_PASSWORD=<SMTP_ПАРОЛЬ>
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@<ВАШ_ДОМЕН>

# ─── Яндекс OAuth ───────────────────────────────────────
YANDEX_OAUTH_CLIENT_ID=<YANDEX_CLIENT_ID>
YANDEX_OAUTH_SECRET=<YANDEX_SECRET>

# ─── Telegram-боты (прод-токены от BotFather — новые боты, решение 9.5) ──
TELEGRAM_VEHICLE_BOT_TOKEN=<PROD_BOT_TOKEN_VEHICLE>
TELEGRAM_PLANNER_BOT_TOKEN=<PROD_BOT_TOKEN_PLANNER>

# ─── Sentry (опционально; пусто → интеграция отключена) ─
SENTRY_DSN=

# ─── Rate limiting (ТЗ 8.4) ─────────────────────────────
RATELIMIT_LOGIN=100/m
RATELIMIT_SIGNUP=5/m
RATELIMIT_API=300/m

# ─── Безопасность токенов (Хэширование X-Bot-Token, ТЗ 8.2) ─
# Пусто → prod использует SECRET_KEY как пепр. Отдельный пепр позволяет
# ротировать SECRET_KEY без пересчёта хэшей токенов.
BOT_TOKEN_PEPPER=<GEN:bot-token-pepper>

# ─── Fernet (шифрование VIN, ТЗ 8.5). ОБЯЗАТЕЛЕН до первой миграции! ──
# manage.py check --deploy падает core.E001, если пусто при DEBUG=False.
# Смена SECRET_KEY при пустом FERNET_KEY делает ранее зашифрованные VIN нечитаемыми.
FERNET_KEY=<GEN:fernet-key>
